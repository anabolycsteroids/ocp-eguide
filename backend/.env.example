# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/ocp_eguide?schema=public

# JWT secrets — generate long random strings for production
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development

# Allowed frontend origins (comma-separated: local, LAN, preview, production)
# Include your laptop's LAN IP so iPad/other devices can reach the API.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.2:3000
FRONTEND_URL=http://localhost:3000

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
